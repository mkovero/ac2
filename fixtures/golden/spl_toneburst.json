    "numpy": "2.5.2",
    "scipy": "1.18.0"
  },
  "parameters": {
    "fs_hz": 48000.0,
    "tone_hz": 4000.0,
    "amplitude_fs": 0.5,
    "burst": "x = amp sin(2 pi f0 k / fs), k = 0..round(Tb fs)-1, starting at a zero crossing after 10 ms of silence; zeros afterwards",
    "detector": "ms[n] = ms[n-1] + alpha (x[n]^2 - ms[n-1]), alpha = 1 - exp(-1/(fs tau)), ms[-1] = 0 (scipy.signal.lfilter([alpha], [1, alpha - 1], x^2))",
    "tau_s": {
      "F": 0.125,
      "S": 1.0
    },
    "response_db": "10 log10(max ms / (amp^2/2))",
    "eq7": "10 log10(1 - exp(-Tb / tau))"
  },
  "references": [
    "IEC 61672-1:2013 5.8, 5.9, Table 4 and Formula 7"
