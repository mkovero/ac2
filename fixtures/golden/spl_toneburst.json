  "name": "spl_toneburst",
  "description": "Maximum F and S time-weighted level of isolated 4 kHz tonebursts relative to the steady level, from a one-pole exponential average of the squared signal (Z weighting), plus IEC 61672-1 Formula 7.",
  "generator": {
    "script": "tools/refgen/generate.py",
    "function": "gen_spl_toneburst"
  },
